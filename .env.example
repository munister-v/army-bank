# Army Bank — приклад конфігурації. Скопіюйте в .env і заповніть.

# PostgreSQL (основний варіант)
DATABASE_URL=postgresql://user:password@localhost:5432/army_bank

# Або залиште порожнім для SQLite (файл database/army_bank.db)
# DATABASE_URL=

# Секрет для сесій та токенів
SECRET_KEY=your-secret-key-min-32-chars

# Messenger encryption keys (Fernet, urlsafe base64, 32-byte).
# Можна вказати кілька ключів через кому для ротації.
# Приклад генерації:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSENGER_ENCRYPTION_KEYS=

# Таймаут очікування відповіді на дзвінок (сек), мінімум 15
MESSENGER_CALL_PENDING_TIMEOUT_SECONDS=45

# ICE сервери для WebRTC (JSON-масив). Додайте TURN для стабільності в мобільних мережах.
# Приклад:
# MESSENGER_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.your-domain.com:3478"],"username":"user","credential":"pass"}]
MESSENGER_ICE_SERVERS=

# Або простіше (без JSON) — через окремі TURN змінні:
# MESSENGER_TURN_URLS=turn:turn.your-domain.com:3478,turns:turn.your-domain.com:5349?transport=tcp
# MESSENGER_TURN_USERNAME=user
# MESSENGER_TURN_CREDENTIAL=pass
MESSENGER_TURN_URLS=
MESSENGER_TURN_USERNAME=
MESSENGER_TURN_CREDENTIAL=

# Час життя токена (години)
TOKEN_TTL_HOURS=24

# Режим відлагодження (1 або 0)
DEBUG=1

# Базовий шлях на сайті (наприклад /bank для munister.com.ua/bank)
# BASE_PATH=/bank

# OpenRouter (openrouter.ai) — безкоштовні LLM-моделі для AI-чернеток лідів
# (генератор cold-outreach повідомлень + підказки відповідей у чаті).
# OPENROUTER_API_KEY=sk-or-v1-...
